{
  "name": "jangal",
  "productName": "Jangal",
  "version": "2.3.0",
  "description": "Study timer, planner and focus tracker",
  "main": "main.js",
  "author": "dodounjie129",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.pkleft.jangal",
    "productName": "Jangal",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ]
  },
  "devDependencies": {
    "electron": "^40.10.2",
    "electron-builder": "^26.18.0"
  },
  "license": "MIT"
}
